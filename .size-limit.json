[
  {
    "name": "Initial JS (entry + vendor)",
    "path": "dist/assets/index-*.js",
    "limit": "260 kB",
    "gzip": true
  },
  {
    "name": "Initial CSS",
    "path": "dist/assets/index-*.css",
    "limit": "30 kB",
    "gzip": true
  },
  {
    "name": "PIN directory: largest part (pin-50, Telangana and Andhra Pradesh)",
    "path": "dist/assets/pin-50-*.js",
    "limit": "31 kB",
    "gzip": true
  },
  {
    "name": "PIN directory: all parts",
    "path": "dist/assets/pin-[0-9][0-9]-*.js",
    "limit": "850 kB",
    "gzip": true
  }
]
