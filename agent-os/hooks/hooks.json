{
  "description": "Single source of truth for clinozy-fe agent hook wiring. tooling/agent-os/generate.ts derives agent-os/platforms/claude/settings.json (hooks block), agent-os/platforms/cursor/hooks.json, and agent-os/platforms/codex/hooks.json from this manifest + agent-os/platforms/targets.json. Tool dirs (.claude/, .cursor/, .codex/) symlink into agent-os/platforms/ — edit here only. Every hook is a Node script (node agent-os/hooks/<script>) on the shared _fe-hook.mjs helper. All hooks FAIL OPEN.",
  "hooks": [
    {
      "id": "fe-session-start",
      "script": "fe-session-start.mjs",
      "claude": {
        "event": "SessionStart",
        "matcher": "startup|resume"
      },
      "codex": {
        "event": "SessionStart",
        "matcher": "startup|resume",
        "statusMessage": "Loading clinozy-fe session context"
      }
    },
    {
      "id": "fe-prompt-skill-router",
      "script": "fe-prompt-skill-router.mjs",
      "claude": {
        "event": "UserPromptSubmit"
      },
      "codex": {
        "event": "UserPromptSubmit",
        "statusMessage": "Checking clinozy-fe skill routing"
      }
    },
    {
      "id": "fe-guard-edits",
      "script": "fe-guard-edits.mjs",
      "claude": {
        "event": "PreToolUse",
        "matcher": "Edit|Write|MultiEdit"
      }
    },
    {
      "id": "fe-guardrails",
      "script": "fe-guardrails.mjs",
      "claude": {
        "event": "PreToolUse",
        "matcher": "Bash|Read|Grep|Edit|Write|MultiEdit"
      },
      "codex": {
        "event": "PreToolUse",
        "matcher": "^Bash$",
        "statusMessage": "Checking clinozy-fe shell guardrails"
      }
    },
    {
      "id": "fe-edit-hooks",
      "script": "fe-edit-hooks.mjs",
      "claude": {
        "event": "PostToolUse",
        "matcher": "Edit|Write",
        "if": ["Edit(**)", "Write(**)"]
      }
    },
    {
      "id": "fe-edit-hooks-stop",
      "script": "fe-edit-hooks.mjs",
      "claude": {
        "event": "Stop"
      },
      "codex": {
        "event": "Stop",
        "statusMessage": "Checking clinozy-fe completion gates"
      }
    },
    {
      "id": "fe-turn-end-tests",
      "script": "fe-turn-end-tests.mjs",
      "claude": {
        "event": "Stop",
        "asyncRewake": true,
        "timeout": 120
      }
    },
    {
      "id": "fe-push-ci-watch",
      "script": "fe-push-ci-watch.mjs",
      "claude": {
        "event": "PostToolUse",
        "matcher": "Bash",
        "if": ["Bash(git push*)"],
        "asyncRewake": true,
        "timeout": 2700
      }
    },
    {
      "id": "fe-gate-failure-hint",
      "script": "fe-gate-failure-hint.mjs",
      "claude": {
        "event": "PostToolUseFailure",
        "matcher": "Bash"
      }
    },
    {
      "id": "fe-compact-resume-card",
      "script": "fe-compact-resume-card.mjs",
      "claude": {
        "event": "SessionStart",
        "matcher": "compact"
      }
    },
    {
      "id": "fe-session-end",
      "script": "fe-session-end.mjs",
      "claude": {
        "event": "SessionEnd"
      }
    },
    {
      "id": "fe-cursor-shell-guard",
      "script": "fe-cursor-shell-guard.mjs",
      "cursor": {
        "event": "beforeShellExecution"
      }
    }
  ]
}
