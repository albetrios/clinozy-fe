{
  "description": "GENERATED by `pnpm agent-os:generate` from agent-os/skills/chains.json and each skill's `trigger` / `triggerNote` frontmatter — the rows of agent-os/docs/skill-triggers.md. Do not edit.",
  "routes": [
    {
      "chain": "page-change",
      "globs": ["src/pages/**/*.route.tsx"],
      "skills": [
        "fe-page-scaffolding",
        "fe-route-island",
        "fe-e2e-testids",
        "fe-test-generation"
      ],
      "optional": ["fe-routing-tenancy"],
      "note": "Adding or changing a page / route island end-to-end."
    },
    {
      "chain": "fe-component-promotion",
      "globs": ["src/shared/components/**/*.tsx"],
      "skills": ["fe-component-promotion", "composition-patterns", "fe-test-generation"],
      "note": "Promoting a page-local component up the ladder into shared / family-shared."
    },
    {
      "chain": "fe-resource-crud",
      "globs": ["src/pages/**/*.resource.ts"],
      "skills": [
        "fe-resource-crud",
        "fe-http-forms-errors",
        "fe-i18n-constants",
        "fe-test-generation"
      ],
      "note": "Scaffolding a backend resource UI — list page plus URL-driven create/edit dialogs."
    },
    {
      "chain": "ui-review",
      "globs": ["src/**/components/**/*.tsx"],
      "skills": ["frontend-design", "web-design-guidelines"],
      "optional": ["review-animations", "fe-theme-axis-audit", "fe-visual-regression"],
      "note": "Building or restyling UI — craft, accessibility, and motion review. review-animations is manual-only (disable-model-invocation, /review-animations) and reviews motion code only, so it is optional — run it on a diff that animates."
    },
    {
      "chain": "form-mutation",
      "globs": ["src/**/forms/**/*.tsx"],
      "skills": ["composition-patterns", "fe-http-forms-errors", "fe-test-generation"],
      "note": "Building a form that mutates via apiClient and maps server/validation errors."
    },
    {
      "chain": "data-hook",
      "globs": ["**/*.api.ts", "**/hooks/use*/**"],
      "skills": ["react-best-practices", "fe-test-generation"],
      "note": "Adding a TanStack Query hook / data layer over the fetch client."
    },
    {
      "chain": "styling",
      "globs": ["src/index.css", "**/*.css"],
      "skills": ["frontend-design", "web-design-guidelines"],
      "optional": ["fe-theme-axis-audit", "fe-visual-regression"],
      "note": "Styling / theming with semantic tokens and Tailwind."
    },
    {
      "chain": "env-change",
      "globs": ["src/core/config/env-schema.ts"],
      "skills": ["fe-env-schema-add"],
      "optional": ["fe-platform-hygiene"],
      "note": "Adding, renaming, or removing an env var and keeping schema + templates in sync."
    },
    {
      "chain": "new-guard",
      "globs": ["tooling/validate/**"],
      "skills": [
        "fe-guard-authoring",
        "fe-code-quality-security",
        "fe-documentation-maintenance"
      ],
      "note": "Adding a machine-enforced invariant (validator, eslint restriction, CI static-sync step)."
    },
    {
      "chain": "i18n-surface",
      "globs": ["src/locales/**"],
      "skills": [
        "fe-i18n-constants",
        "fe-locale-formatting",
        "fe-rtl-logical-css",
        "fe-test-generation"
      ],
      "optional": ["fe-locale-preferences"],
      "note": "Adding or changing user-facing copy, dates/numbers, or locale preferences."
    },
    {
      "chain": "agent-os-change",
      "globs": ["agent-os/skills/**"],
      "skills": ["fe-agent-os-authoring", "fe-documentation-maintenance"],
      "note": "Adding, renaming or removing an agent-os skill or rule."
    },
    {
      "chain": "design-build",
      "globs": ["iterations/**"],
      "skills": [
        "fe-iteration-planning",
        "fe-kickoff-iteration",
        "fe-design-ditto",
        "fe-route-island",
        "fe-test-generation"
      ],
      "optional": ["fe-page-scaffolding", "fe-theme-axis-audit", "fe-visual-regression"],
      "note": "Planning (no code, ends at approval) and then building a design iteration from its iterations/<iteration>/intake-files/ (markdown specs + prototype), one ledger row at a time."
    },
    {
      "chain": "vendored-ui",
      "globs": ["**/components/ui/*"],
      "skills": ["shadcn"],
      "note": "Changing a vendored shadcn primitive — through the shadcn CLI, never by hand."
    },
    {
      "chain": "component-change",
      "globs": ["**/components/**/*.tsx", "**/forms/**"],
      "skills": [
        "shadcn",
        "composition-patterns",
        "frontend-design",
        "fe-test-generation"
      ],
      "note": "Adding or changing a component or form — shadcn first, then composition, craft and a colocated test."
    },
    {
      "chain": "motion",
      "globs": ["**/useOnboardingStepMotion.ts", "**/*Motion.ts"],
      "skills": ["animejs", "emil-design-eng"],
      "optional": ["review-animations"],
      "note": "Animation hooks (useOnboardingStepMotion and the like) — implement with Anime.js, held to the motion craft bar."
    },
    {
      "globs": ["agent-os/rules/**"],
      "skills": ["fe-agent-os-authoring"],
      "note": "Eight surfaces; regenerate the tree last"
    },
    {
      "globs": ["vite.config.ts", "tooling/ci/run-size-limit.mjs", ".size-limit.json"],
      "skills": ["fe-bundle-performance"],
      "note": "And any size-budget change"
    },
    {
      "globs": ["netlify.toml", ".husky/**", ".github/workflows/**", "eslint.config.mjs"],
      "skills": ["fe-code-quality-security"],
      "note": "The deploy path (always netlify deploy --no-build), the git hooks, the CI workflows and the lint config"
    },
    {
      "globs": ["**/*.contracts.ts", "**/*.constants.ts"],
      "skills": ["fe-code-structure"],
      "note": "Where the code goes — contracts, constants, the promotion ladder"
    },
    {
      "globs": ["package.json", "pnpm-lock.yaml", "pnpm-workspace.yaml"],
      "skills": ["fe-dependency-management"],
      "note": "Dependencies and overrides — the lockfile in the same commit"
    },
    {
      "globs": [
        "docs/**/*.md",
        "**/*.OVERVIEW.md",
        ".env.example",
        "README.md",
        "CLAUDE.md",
        "**/CLAUDE.md",
        "agent-os/skills/**",
        "agent-os/rules/**"
      ],
      "skills": ["fe-documentation-maintenance"],
      "note": "Which doc to update and where it lives"
    },
    {
      "globs": ["tests/e2e/**"],
      "skills": ["fe-e2e-testids"],
      "note": "Hybrid selectors — data-testid for actions"
    },
    {
      "globs": [
        "src/core/config/env-schema.ts",
        "src/core/config/client-env-schema.ts",
        ".env.example",
        "**/platform-config.ts",
        "**/build-env.ts",
        "knip.jsonc"
      ],
      "skills": ["fe-env-schema-add"],
      "note": "If an env key changed"
    },
    {
      "globs": [".vscode/**"],
      "skills": ["fe-extension-settings-recommendations"],
      "note": "Workspace extensions and settings"
    },
    {
      "globs": [
        "eslint.config.mjs",
        ".github/workflows/**",
        "netlify.toml",
        "plugins/dev-server-mode.ts",
        "plugins/build-environment.ts",
        "tooling/ci/build.mjs",
        "tooling/setup/github/scaffold-env-files.mjs"
      ],
      "skills": ["fe-guard-authoring"],
      "note": "Restrictions and CI steps — probe both directions; wire into CI, not just health-check; the env-file plugins' policy tests"
    },
    {
      "globs": ["**/forms/**"],
      "skills": ["fe-http-forms-errors"],
      "note": "Forms, and mutation hooks touching apiClient"
    },
    {
      "globs": ["**/*.constants.ts"],
      "skills": ["fe-i18n-constants"],
      "note": "New user-facing copy or a locale namespace"
    },
    {
      "globs": ["eslint.config.mjs"],
      "skills": ["fe-lint-guard"],
      "note": "A lint config change — then fix what it flags"
    },
    {
      "globs": ["src/lib/i18n/format.ts", "**/useLocaleFormat/**", "**/*.constants.ts"],
      "skills": ["fe-locale-formatting"],
      "note": "And any date, number or money render; constants only when they hold dates or numbers"
    },
    {
      "globs": ["**/useLocaleStore/**", "public/locale-init.js", "src/locales/**"],
      "skills": ["fe-locale-preferences"],
      "note": "And BUILD_I18N_MODE"
    },
    {
      "globs": ["src/pages/**"],
      "skills": ["fe-page-scaffolding"],
      "note": "A new or changed page island"
    },
    {
      "globs": ["docs/deployment/path-to-production.md"],
      "skills": ["fe-path-to-production"],
      "note": "Or the user asks to release / deploy to production / path to production — the readiness plan the user approves, then the Release PR, the approved deploy and the live check"
    },
    {
      "globs": [
        "src/core/config/env-schema.ts",
        "**/platform-config.ts",
        "**/build-env.ts",
        "knip.jsonc",
        ".env.example",
        "plugins/dev-server-mode.ts",
        "plugins/build-environment.ts",
        "tooling/ci/build.mjs",
        "tooling/setup/github/scaffold-env-files.mjs",
        ".github/rulesets/**",
        ".github/environments/**",
        "tooling/setup/github/governance-mode.mjs",
        "tooling/validate/**"
      ],
      "skills": ["fe-platform-hygiene"],
      "note": "Env schema, Vite env reads, knip, the validators; which env file each command reads; governance mode — use github:tool:governance-mode, never hand-edit review fields"
    },
    {
      "globs": ["tests/e2e/**"],
      "skills": ["fe-playwright-e2e"],
      "note": "Playwright E2E (local-only; needs clinozy-be on :3000)"
    },
    {
      "globs": [
        "src/core/config/app-manifest.ts",
        "public/manifest.webmanifest",
        "public/app-icon.svg"
      ],
      "skills": ["fe-pwa-manifest"],
      "note": "The PWA install surface"
    },
    {
      "globs": ["**/useAppMutation/**", "**/useDeferredRowRemoval/**"],
      "skills": ["fe-resilient-interactions"],
      "note": "Writes that can double-submit, deferred removals, error boundaries"
    },
    {
      "globs": ["**/*.resource.ts", "**/*ListPage.tsx", "**/dialogs/**"],
      "skills": ["fe-resource-crud"],
      "note": "Resource manifest, list page, URL-driven dialogs"
    },
    {
      "globs": ["**/*.route.tsx", "**/*.manifest.ts", "src/pages/**"],
      "skills": ["fe-route-island"],
      "note": "Route marker, manifest or any page-island file — the page directory shape is docs/reference/route-island-structure.md"
    },
    {
      "globs": [
        "src/app/routes/routeTree.tsx",
        "src/app/guards/**",
        "src/shared/tenancy/**"
      ],
      "skills": ["fe-routing-tenancy"],
      "note": "Organization-scoped routes, guard chains, gatewayFromManifest, session context"
    },
    {
      "globs": ["**/*.test.ts", "**/*.test.tsx"],
      "skills": ["fe-test-generation"],
      "note": "Tests — colocated, with the coverage ratchet"
    },
    {
      "globs": ["tests/e2e/visual.e2e.test.ts", "tests/e2e/*-snapshots/**"],
      "skills": ["fe-visual-regression"],
      "note": "Screenshot baselines (needs clinozy-be up; local-only lane)"
    }
  ]
}
