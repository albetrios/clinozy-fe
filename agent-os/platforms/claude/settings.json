{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "allow": [
      "Bash(pnpm validate*)",
      "Bash(pnpm test*)",
      "Bash(pnpm lint*)",
      "Bash(pnpm type-check*)",
      "Bash(pnpm biome*)",
      "Bash(pnpm format*)",
      "Bash(pnpm health*)",
      "Bash(pnpm quality*)",
      "Bash(pnpm ci*)",
      "Bash(pnpm docs*)",
      "Bash(pnpm tsdoc*)",
      "Bash(pnpm agent-os*)",
      "Bash(pnpm iteration*)",
      "Bash(pnpm sync*)",
      "Bash(pnpm knip*)",
      "Bash(pnpm size*)",
      "Bash(pnpm coverage*)",
      "Bash(pnpm build*)",
      "Bash(pnpm sonar*)",
      "Bash(pnpm api*)",
      "Bash(pnpm app*)",
      "Bash(pnpm contracts*)",
      "Bash(pnpm dev*)",
      "Bash(pnpm preview*)",
      "Bash(pnpm install)",
      "Bash(pnpm install --frozen-lockfile)",
      "Bash(pnpm install --prefer-offline)",
      "Bash(pnpm security*)",
      "Bash(pnpm deps:check*)",
      "Bash(pnpm deps:audit*)",
      "Bash(pnpm tool:project-structure-tree*)",
      "Bash(git status)",
      "Bash(git diff*)",
      "Bash(git log*)",
      "Bash(git branch*)",
      "Bash(git add *)",
      "Bash(git commit *)",
      "Bash(git push *)",
      "Bash(git switch *)",
      "Bash(gh pr*)",
      "Bash(gh issue*)",
      "Bash(gh run *)",
      "mcp__context7__*",
      "mcp__shadcn__*",
      "mcp__tailwindcss__*",
      "mcp__codegraph__*",
      "mcp__headroom__*",
      "mcp__github__get_*",
      "mcp__github__list_*",
      "mcp__github__search_*",
      "mcp__github__pull_request_read",
      "mcp__github__issue_read",
      "mcp__github__actions_get",
      "mcp__github__actions_list"
    ],
    "ask": [
      "Bash(gh pr create *)",
      "Bash(pnpm dlx *)",
      "Bash(pnpm add *)",
      "Bash(pnpm exec *)"
    ],
    "deny": [
      "Bash(git push --force *)",
      "Bash(git push -f *)",
      "Bash(rm -rf *)",
      "mcp__github__delete_file"
    ]
  },
  "hooks": {
    "SessionStart": [
      {
        "matcher": "startup|resume",
        "hooks": [
          {
            "type": "command",
            "command": "bash \"$CLAUDE_PROJECT_DIR/agent-os/hooks/fe-session-start.sh\""
          }
        ]
      },
      {
        "matcher": "compact",
        "hooks": [
          {
            "type": "command",
            "command": "bash \"$CLAUDE_PROJECT_DIR/agent-os/hooks/fe-compact-resume-card.sh\""
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "bash \"$CLAUDE_PROJECT_DIR/agent-os/hooks/fe-prompt-skill-router.sh\""
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Edit|Write|MultiEdit",
        "hooks": [
          {
            "type": "command",
            "command": "bash \"$CLAUDE_PROJECT_DIR/agent-os/hooks/fe-guard-edits.sh\""
          }
        ]
      },
      {
        "matcher": "Bash|Read|Grep|Edit|Write|MultiEdit",
        "hooks": [
          {
            "type": "command",
            "command": "node \"$CLAUDE_PROJECT_DIR/agent-os/hooks/fe-guardrails.mjs\""
          }
        ]
      },
      {
        "matcher": "mcp__github__create_pull_request",
        "hooks": [
          {
            "type": "command",
            "command": "bash \"$CLAUDE_PROJECT_DIR/agent-os/hooks/fe-no-unrequested-pr.sh\""
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Edit|Write",
        "hooks": [
          {
            "type": "command",
            "command": "node \"$CLAUDE_PROJECT_DIR/agent-os/hooks/fe-edit-hooks.mjs\"",
            "if": "Edit(**)"
          },
          {
            "type": "command",
            "command": "node \"$CLAUDE_PROJECT_DIR/agent-os/hooks/fe-edit-hooks.mjs\"",
            "if": "Write(**)"
          }
        ]
      },
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "node \"$CLAUDE_PROJECT_DIR/agent-os/hooks/fe-push-ci-watch.mjs\"",
            "if": "Bash(git push*)",
            "asyncRewake": true,
            "timeout": 2700
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node \"$CLAUDE_PROJECT_DIR/agent-os/hooks/fe-edit-hooks.mjs\""
          }
        ]
      },
      {
        "hooks": [
          {
            "type": "command",
            "command": "node \"$CLAUDE_PROJECT_DIR/agent-os/hooks/fe-turn-end-tests.mjs\"",
            "asyncRewake": true,
            "timeout": 120
          }
        ]
      }
    ],
    "PostToolUseFailure": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "bash \"$CLAUDE_PROJECT_DIR/agent-os/hooks/fe-gate-failure-hint.sh\""
          }
        ]
      }
    ],
    "SessionEnd": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "bash \"$CLAUDE_PROJECT_DIR/agent-os/hooks/fe-session-end.sh\""
          }
        ]
      }
    ]
  }
}
