#!/usr/bin/env sh
# Fast gate before push — full suite runs in CI (.github/workflows/pr-ci.yml).

# Branch-name policy — short-lived branches follow <type>/<description>
# (parity with clinozy-be). The trunk and a detached HEAD are exempt. The trunk is
# resolved from tooling/setup/setup.config.json (git.defaultBranch), never
# hardcoded, so a renamed trunk stays exempt automatically. Claude Code web
# session branches (claude/*) are allowlisted as a FALLBACK — the cloud git proxy
# does NOT pin a session to its claude/* branch (a push under any conventional
# name succeeds), but it does refuse every form of branch delete, so rename
# before the first push. See agent-os/rules/fe-git-branch-naming.mdc. Bypass once:
#   SKIP_BRANCH_CHECK=1 git push
CURRENT_BRANCH=$(git rev-parse --abbrev-ref HEAD 2>/dev/null || echo HEAD)
DEFAULT_BRANCH=$(node tooling/ci/git-environment.mjs trunk 2>/dev/null || echo main)
if [ "${SKIP_BRANCH_CHECK:-0}" = "1" ]; then
  echo "Skipping branch-name policy on pre-push."
elif [ "$CURRENT_BRANCH" != "HEAD" ] && [ "$CURRENT_BRANCH" != "$DEFAULT_BRANCH" ]; then
  if ! printf '%s' "$CURRENT_BRANCH" | grep -Eq '^(claude/.+|(feat|feature|fix|hotfix|chore|ci|docs|refactor|test|perf|build|style|revert)/[a-z0-9._-]+)$'; then
    echo "✖ Branch name '$CURRENT_BRANCH' does not follow <type>/<description>." >&2
    echo "  Allowed types: feat feature fix hotfix chore ci docs refactor test perf build style revert" >&2
    echo "  Description: lowercase letters, digits, . _ - (e.g. ci/branch-name-guard)." >&2
    echo "  AI web sessions: claude/*.  Bypass once: SKIP_BRANCH_CHECK=1 git push" >&2
    echo "  Rename with: git branch -m <type>/<description>" >&2
    exit 1
  fi
fi

pnpm biome:check
pnpm type-check
# Dead code and the bundle-size budget: CI's Knip and Build lanes, which every recent red PR CI
# run failed on. The build reads no env file (--defaults), as CI's Build verify lane builds: the
# size budget is measured on that build, and a .env.local build carries ~11 kB more first-paint JS.
pnpm knip
pnpm build --defaults
pnpm build:check
pnpm size

# The base every step below measures the push from, computed once (resolveBase in
# tooling/ci/git-environment.mjs): the upstream, else origin/<trunk> on a branch's first push —
# without an upstream the diff would be empty and every gate below would skip.
PUSH_BASE=$(node tooling/ci/git-environment.mjs base) || {
  echo "✖ Cannot resolve the push base (tooling/ci/git-environment.mjs base)." >&2
  exit 1
}

# Which pushed files make a step below run is one rule, pushSteps in tooling/ci/affected.mjs (the
# `pnpm test:affected` preview prints the same answers). It answers yes or no; anything else (it
# could not run) runs the step, so a broken answer never skips a gate.
step_runs() {
  [ "$(node tooling/ci/affected.mjs --base "$PUSH_BASE" --runs "$1")" != "no" ]
}

# Markdown lint on the pushed diff (mirrors the Docs lint CI lane). lint-staged
# only formats staged markdown; this lints every changed file in the push.
if step_runs 'pnpm docs:lint:changed'; then
  pnpm docs:lint:changed --base "$PUSH_BASE"
else
  echo "Skipping changed-markdown lint on pre-push (no markdown changes)."
fi

# Unit tests (matches the CI unit lane).
# Run only when pushed commits include unit-relevant files (UNIT_RELEVANT in affected.mjs).
# `pnpm test:pre-push` runs the files `pnpm test:select` picks for them (an escalating change, or a
# selection that cannot be built, runs the whole suite; CI runs every suite).
if step_runs 'pnpm test:pre-push'; then
  pnpm test:pre-push --base "$PUSH_BASE"
else
  echo "Skipping unit tests on pre-push (no unit-relevant changes)."
fi

# The generated platform files (agent-os/platforms/*) must match their agent-os sources — run when
# agent-os/ or its generator is pushed (AGENT_OS_GENERATED_RELEVANT in affected.mjs).
if step_runs 'pnpm agent-os:generate:check'; then
  pnpm agent-os:generate:check
else
  echo "Skipping the agent-os generate check on pre-push (no agent-os changes)."
fi

# Semgrep on every pushed source file under src/ and plugins/ (the PR's Semgrep lane scans
# everything) — an early check: a finding blocks; no semgrep → a warning.
pnpm security:semgrep:push --base "$PUSH_BASE"

# API contract drift — every endpoint this app references must exist in
# clinozy-be's committed route catalog (skips with a notice when the sibling
# clinozy-be checkout is absent). Catches endpoint typos before they ship.
pnpm contracts:drift

# API types — src/core/http/openapi-types.d.ts must match clinozy-be's OpenAPI document
# (`pnpm docs:generate` there; skips with a notice when the document is absent).
pnpm api:types:check

# SonarQube quality gate — scans against the local SonarQube server and BLOCKS the push if any
# unresolved Sonar issue exists. Runs only when the pushed commits touch deployed-surface code
# (src/ runtime — the only thing Sonar analyzes; tests/mocks/fixtures/scripts are excluded). The
# gate auto-starts the server on first use (first boot ~2 min) and provisions a token in
# .env.local. There is no per-gate skip: a red Sonar gate must be fixed, not bypassed.
# The files are SONAR_RUNTIME without SONAR_EXCLUDED, in affected.mjs.
if step_runs 'pnpm sonar:scan'; then
  pnpm sonar:scan
else
  echo "Skipping SonarQube gate on pre-push (no deployed-surface code changes)."
fi
